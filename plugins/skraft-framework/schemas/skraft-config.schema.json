{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "skraft-config.json",
  "description": "The team's skraft configuration, committed: components and the team's model assignment; no workflow (skraft workflow eject copies the pipeline into .skraft/pipeline.skraft.dot) over the plugin's defaults.",
  "type": "object",
  "properties": {
    "rank": false,
    "baseBranch": {
      "$ref": "skraft-config.local.schema.json#/$defs/baseBranch"
    },
    "forge": {
      "$ref": "skraft-config.local.schema.json#/$defs/forge"
    },
    "tdd": {
      "$ref": "skraft-config.local.schema.json#/$defs/tdd"
    },
    "publish": {
      "$ref": "skraft-config.local.schema.json#/$defs/publish"
    },
    "models": {
      "$ref": "skraft-config.local.schema.json#/$defs/models"
    },
    "assign": {
      "$ref": "skraft-config.local.schema.json#/$defs/assign"
    },
    "workflow": false,
    "components": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "#/$defs/component"
      }
    }
  },
  "$defs": {
    "innerFolder": {
      "description": "A folder inside the component root: relative, never absolute, never leaving the root.",
      "type": "string",
      "allOf": [
        {
          "pattern": "\\S"
        },
        {
          "not": {
            "pattern": "^([\\\\/]|[A-Za-z]:)"
          }
        },
        {
          "not": {
            "pattern": "^\\.\\."
          }
        }
      ]
    },
    "mechanism": {
      "description": "What a row of the infrastructure policy runs a dependency on in a test.",
      "enum": [
        "in-process",
        "real",
        "in-memory",
        "testcontainers",
        "microcks",
        "fake",
        "msw"
      ]
    },
    "innerPattern": {
      "description": "A path or a glob inside the component root: relative, never absolute, never naming ..",
      "type": "string",
      "allOf": [
        {
          "pattern": "\\S"
        },
        {
          "not": {
            "pattern": "^([\\\\/]|[A-Za-z]:)"
          }
        },
        {
          "not": {
            "pattern": "(^|[\\\\/])\\.\\.([\\\\/]|$)"
          }
        }
      ]
    },
    "backStages": {
      "type": "object",
      "properties": {
        "targeted": {
          "$ref": "#/$defs/mechanism"
        },
        "walkingSkeleton": {
          "$ref": "#/$defs/mechanism"
        }
      },
      "additionalProperties": false
    },
    "targetedStage": {
      "type": "object",
      "properties": {
        "targeted": {
          "$ref": "#/$defs/mechanism"
        }
      },
      "additionalProperties": false
    },
    "frontToBackStages": {
      "type": "object",
      "properties": {
        "targeted": {
          "$ref": "#/$defs/mechanism"
        },
        "e2e": {
          "$ref": "#/$defs/mechanism"
        }
      },
      "additionalProperties": false
    },
    "backInfrastructure": {
      "description": "The rows a back-end component overrides; externalGateway follows mocking.strategy.",
      "type": "object",
      "properties": {
        "entryPoint": {
          "$ref": "#/$defs/backStages"
        },
        "internalGateway": {
          "$ref": "#/$defs/backStages"
        },
        "externalGateway": false,
        "clock": {
          "$ref": "#/$defs/backStages"
        }
      },
      "additionalProperties": false
    },
    "frontInfrastructure": {
      "description": "The rows a React component overrides; it has no walking skeleton, its end-to-end run is e2e.",
      "type": "object",
      "properties": {
        "entryPoint": {
          "$ref": "#/$defs/targetedStage"
        },
        "frontToBack": {
          "$ref": "#/$defs/frontToBackStages"
        },
        "externalGateway": false,
        "clock": {
          "$ref": "#/$defs/targetedStage"
        }
      },
      "additionalProperties": false
    },
    "component": {
      "type": "object",
      "required": [
        "name",
        "root",
        "stack"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "root": {
          "description": "Relative to the working copy.",
          "type": "string",
          "allOf": [
            {
              "pattern": "\\S"
            },
            {
              "not": {
                "pattern": "^([\\\\/]|[A-Za-z]:)"
              }
            }
          ]
        },
        "stack": {
          "enum": [
            "dotnet",
            "java",
            "python",
            "typescript",
            "javascript",
            "react"
          ]
        },
        "paths": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "src": {
              "type": "array",
              "items": {
                "type": "string",
                "allOf": [
                  {
                    "pattern": "\\S"
                  },
                  {
                    "not": {
                      "pattern": "^([\\\\/]|[A-Za-z]:)"
                    }
                  },
                  {
                    "not": {
                      "pattern": "^\\.\\."
                    }
                  }
                ]
              }
            },
            "tests": {
              "type": "array",
              "items": {
                "type": "string",
                "allOf": [
                  {
                    "pattern": "\\S"
                  },
                  {
                    "not": {
                      "pattern": "^([\\\\/]|[A-Za-z]:)"
                    }
                  },
                  {
                    "not": {
                      "pattern": "^\\.\\."
                    }
                  }
                ]
              }
            }
          }
        },
        "commands": {
          "type": [
            "object",
            "null"
          ],
          "propertyNames": {
            "enum": [
              "build",
              "format",
              "lint",
              "test",
              "architecture",
              "coverage",
              "mutation",
              "e2e"
            ]
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "\\S"
          }
        },
        "baseBranch": {
          "$ref": "skraft-config.local.schema.json#/$defs/baseBranch"
        },
        "mocking": {
          "description": "How the component's tests mock what another team owns: microcks by default, inprocess by default for react.",
          "type": "object",
          "properties": {
            "strategy": {
              "enum": [
                "microcks",
                "inprocess",
                null
              ]
            }
          }
        },
        "contractTesting": {
          "type": "boolean"
        },
        "bdd": {
          "description": "Where each runner of this component reads its scenarios and the definitions that bind them, one pair per runner; or false when its tests are written without Gherkin. An absent key, and a bare true, decide nothing: no folder is invented from the stack, so a run is refused until one of the two is written.",
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "properties": {
                  "runner": {
                    "type": "string"
                  },
                  "features": {
                    "$ref": "#/$defs/innerFolder"
                  },
                  "steps": {
                    "$ref": "#/$defs/innerFolder"
                  }
                },
                "required": [
                  "features"
                ],
                "additionalProperties": false
              }
            }
          ]
        },
        "mutationReport": {
          "description": "The file the mutation command writes its report to, relative to the component root; absent: the one the stack's tool writes.",
          "type": "string",
          "allOf": [
            {
              "pattern": "\\S"
            },
            {
              "not": {
                "pattern": "^([\\\\/]|[A-Za-z]:)"
              }
            },
            {
              "not": {
                "pattern": "^\\.\\."
              }
            }
          ]
        },
        "infrastructure": {
          "description": "The rows of the plugin's infrastructure policy this component's tests override, by dependency kind: entryPoint, internalGateway and clock for a back end, entryPoint, frontToBack and clock for React; each stage one of the mechanisms. externalGateway follows mocking.strategy.",
          "type": "object"
        },
        "testReports": {
          "description": "Where the component's test and e2e commands write JUnit XML, paths or globs relative to the component root; absent: its stack's (dotnet **/TestResults/*.trx and **/TestResults/*.xml; java **/target/surefire-reports/TEST-*.xml and **/build/test-results/test/*.xml; python, typescript, javascript and react reports/junit.xml).",
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/innerPattern"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "stack": {
                "const": "react"
              }
            },
            "required": [
              "stack"
            ]
          },
          "then": {
            "properties": {
              "infrastructure": {
                "$ref": "#/$defs/frontInfrastructure"
              }
            }
          },
          "else": {
            "properties": {
              "infrastructure": {
                "$ref": "#/$defs/backInfrastructure"
              }
            }
          }
        }
      ],
      "additionalProperties": false
    }
  }
}
