{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "skraft-config.json",
  "description": "The team's skraft configuration, committed: components and the team's model assignment; no workflow (skraft workflow eject copies the pipeline into .skraft/pipeline.skraft.dot) over the plugin's defaults.",
  "type": "object",
  "properties": {
    "rank": false,
    "baseBranch": {
      "$ref": "skraft-config.local.schema.json#/$defs/baseBranch"
    },
    "forge": {
      "$ref": "skraft-config.local.schema.json#/$defs/forge"
    },
    "tdd": {
      "$ref": "skraft-config.local.schema.json#/$defs/tdd"
    },
    "publish": {
      "$ref": "skraft-config.local.schema.json#/$defs/publish"
    },
    "models": {
      "$ref": "skraft-config.local.schema.json#/$defs/models"
    },
    "assign": {
      "$ref": "skraft-config.local.schema.json#/$defs/assign"
    },
    "workflow": false,
    "components": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "#/$defs/component"
      }
    }
  },
  "$defs": {
    "innerFolder": {
      "description": "A folder inside the component root: relative, never absolute, never leaving the root.",
      "type": "string",
      "allOf": [
        {
          "pattern": "\\S"
        },
        {
          "not": {
            "pattern": "^([\\\\/]|[A-Za-z]:)"
          }
        },
        {
          "not": {
            "pattern": "^\\.\\."
          }
        }
      ]
    },
    "component": {
      "type": "object",
      "required": [
        "name",
        "root",
        "stack"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "root": {
          "description": "Relative to the working copy.",
          "type": "string",
          "allOf": [
            {
              "pattern": "\\S"
            },
            {
              "not": {
                "pattern": "^([\\\\/]|[A-Za-z]:)"
              }
            }
          ]
        },
        "stack": {
          "enum": [
            "dotnet",
            "java",
            "python",
            "typescript",
            "javascript",
            "react"
          ]
        },
        "paths": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "src": {
              "type": "array",
              "items": {
                "type": "string",
                "allOf": [
                  {
                    "pattern": "\\S"
                  },
                  {
                    "not": {
                      "pattern": "^([\\\\/]|[A-Za-z]:)"
                    }
                  },
                  {
                    "not": {
                      "pattern": "^\\.\\."
                    }
                  }
                ]
              }
            },
            "tests": {
              "type": "array",
              "items": {
                "type": "string",
                "allOf": [
                  {
                    "pattern": "\\S"
                  },
                  {
                    "not": {
                      "pattern": "^([\\\\/]|[A-Za-z]:)"
                    }
                  },
                  {
                    "not": {
                      "pattern": "^\\.\\."
                    }
                  }
                ]
              }
            }
          }
        },
        "commands": {
          "type": [
            "object",
            "null"
          ],
          "propertyNames": {
            "enum": [
              "build",
              "format",
              "lint",
              "test",
              "architecture",
              "coverage",
              "mutation",
              "e2e"
            ]
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "\\S"
          }
        },
        "baseBranch": {
          "$ref": "skraft-config.local.schema.json#/$defs/baseBranch"
        },
        "mocking": {
          "type": "object",
          "properties": {
            "strategy": {
              "enum": [
                "microcks",
                "inprocess",
                null
              ]
            }
          }
        },
        "contractTesting": {
          "type": "boolean"
        },
        "bdd": {
          "description": "Where each runner of this component reads its scenarios and the definitions that bind them, one pair per runner; or false when its tests are written without Gherkin. An absent key, and a bare true, decide nothing: no folder is invented from the stack, so a run is refused until one of the two is written.",
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "properties": {
                  "runner": {
                    "type": "string"
                  },
                  "features": {
                    "$ref": "#/$defs/innerFolder"
                  },
                  "steps": {
                    "$ref": "#/$defs/innerFolder"
                  }
                },
                "required": [
                  "features"
                ],
                "additionalProperties": false
              }
            }
          ]
        },
        "mutationReport": {
          "description": "The file the mutation command writes its report to, relative to the component root; absent: the one the stack's tool writes.",
          "type": "string",
          "allOf": [
            {
              "pattern": "\\S"
            },
            {
              "not": {
                "pattern": "^([\\\\/]|[A-Za-z]:)"
              }
            },
            {
              "not": {
                "pattern": "^\\.\\."
              }
            }
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
