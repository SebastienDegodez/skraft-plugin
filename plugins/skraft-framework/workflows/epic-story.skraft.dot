// The story-delivery workflow. Runs for one user story that already holds an architecture brief
// (A2 #624) produced by `skraft architecture` through epic-design.skraft.dot. Called by
// `skraft run --issue <n>` when the brief is present and fresh: starts at DISTILL, reads the
// brief and its cited ADRs through the acceptance designer's and the software engineer's
// `Read first`. The input architecture names the brief's path, story names the story file.
// Quasi-duplicate of the tail of pipeline.skraft.dot from `distill` on; both files stay in sync.
// `deliver_review` calls the existing review.skraft.dot (unchanged by this lot).
// each="scenario" goes on two agent nodes: the acceptance designer writes the walking skeleton
// then the failing acceptance test of the first scenario; the software engineer makes it pass;
// the engine runs them again for each next scenario, one failing test commit, one green commit.
digraph skraft {
  graph [version="1", goal="Deliver a story that starts from its architecture brief",
         input_architecture="required", input_story="required"]

  start           [shape=Mdiamond]
  distill         [shape=box, agent="acceptance-designer", phase="DISTILL", each="scenario"]
  subgraph cluster_distill_review {
    label="DISTILL review"
    distill_review_lenses [shape=component]
    distill_review_coverage [shape=note, lens="coverage"]
    distill_review_business_alignment [shape=note, lens="business-alignment"]
    distill_review_testability [shape=note, lens="testability"]
    distill_review_boundary_enforcement [shape=note, lens="boundary-enforcement"]
    distill_review_refuter [shape=octagon, mandatory=true]
    distill_review [shape=tripleoctagon, mandatory=true]
  }
  scenario_review [shape=hexagon, question="scenario-review"]
  deliver         [shape=box, agent="software-engineer", phase="DELIVER", each="scenario"]
  gates           [shape=parallelogram, gate="build,format,lint,test,architecture,coverage", goal_gate=true, locked=true, phase="DELIVER"]
  deliver_review  [shape=house, workflow="review", mandatory=true]
  visuals         [shape=parallelogram, publish="playwright-visuals", when="frontend"]
  pr_writer       [shape=box, agent="pr-writer", phase="PUBLISH"]
  publish         [shape=parallelogram, publish="pull-request"]
  exit            [shape=Msquare]

  start -> distill -> distill_review_lenses
  distill_review_lenses -> distill_review_coverage -> distill_review_refuter
  distill_review_lenses -> distill_review_business_alignment -> distill_review_refuter
  distill_review_lenses -> distill_review_testability -> distill_review_refuter
  distill_review_lenses -> distill_review_boundary_enforcement -> distill_review_refuter
  distill_review_refuter -> distill_review
  distill_review -> distill [label="NEEDS_REWORK", max_visits=2]
  distill_review -> scenario_review [label="APPROVED"]
  scenario_review -> deliver [label="APPROVED"]
  scenario_review -> distill [label="REVISE", max_visits=2]
  deliver -> gates
  gates -> deliver [label="FAIL", max_visits=3]
  gates -> deliver_review [label="PASS"]
  deliver_review -> deliver [label="NEEDS_REWORK", max_visits=2]
  deliver_review -> visuals [label="APPROVED"]
  visuals -> pr_writer -> publish -> exit
}
