{
  "name": "skraft-framework",
  "version": "1.6.0-hooks.1",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "test": "node --test ../../tests/skraft-framework/*.test.mjs",
    "test:mutation": "node plugins/skraft-framework/src/node_modules/.bin/stryker run plugins/skraft-framework/src/stryker.config.mjs",
    "models:check": "node plugins/skraft-framework/src/cli/resolve-model-bin.mjs --check",
    "models:apply": "node plugins/skraft-framework/src/cli/resolve-model-bin.mjs --apply",
    "config:build": "node plugins/skraft-framework/src/cli/build-config-bin.mjs --apply",
    "config:check": "node plugins/skraft-framework/src/cli/build-config-bin.mjs --check"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/tap-runner": "^9.6.1"
  }
}
