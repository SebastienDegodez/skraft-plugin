// The mutation run skraft gives the developer, apart from a story's pipeline: its own tracking folder and journal,
// the base of each component its merge base with the component's baseBranch. The gate mutation runs each component's
// mutation command, the developer's. When the command writes its result to the file SKRAFT_MUTATION_RESULT names
// ({ "scopes": [{ "name": "core" | "boundary" | "global", "score": <percent>, "survivors": ["<file>:<line> <detail>"] }] }),
// that result is judged; otherwise the report the stack's tool writes at its default path. Each scope must reach 80.
// When a scope misses it, kill_proposal proposes, one dispatch per file of survivors, how to treat each survivor
// (a test that kills it, the code deleted, or the mutant declared equivalent) and changes no code; mutation-plan asks
// the developer to choose (APPLY, an instruction of their own, or STOP); kill_mutants applies the choice; the
// test-integrity lens reads the tests it added; the gates run again, then mutation again.
// Copy it into .skraft-design/mutation.skraft.dot to adapt it. A node marked locked=true can only be dropped with
// unlock="<reason>"; a node marked mandatory=true can never be dropped, bypassed or weakened, whatever the copy says.
digraph mutation {
  graph [version="2", goal="Measure and treat the surviving mutants"]

  start         [shape=Mdiamond]
  mutation      [shape=parallelogram, gate="mutation", goal_gate=true, locked=true, phase="DELIVER"]
  kill_proposal [shape=box, agent="design-software-engineer", each="survivor-file", proposal=true]
  mutation_plan [shape=hexagon, question="mutation-plan"]
  kill_mutants  [shape=box, agent="design-software-engineer", each="survivor-file"]
  subgraph cluster_mutation_review {
    label="Review of the kills"
    mutation_review_lenses [shape=component]
    mutation_review_test_integrity [shape=note, lens="test-integrity"]
    mutation_review_refuter [shape=octagon, mandatory=true]
    mutation_review [shape=tripleoctagon, mandatory=true]
  }
  mutation_gates [shape=parallelogram, gate="build,format,lint,test,architecture,coverage", goal_gate=true]
  exit          [shape=Msquare]

  start -> mutation
  mutation -> exit [label="PASS"]
  mutation -> kill_proposal [label="FAIL", max_visits=5]
  kill_proposal -> mutation_plan
  mutation_plan -> kill_mutants [label="APPLY"]
  kill_mutants -> mutation_review_lenses
  mutation_review_lenses -> mutation_review_test_integrity -> mutation_review_refuter
  mutation_review_refuter -> mutation_review
  mutation_review -> kill_mutants [label="NEEDS_REWORK", max_visits=2]
  mutation_review -> mutation_gates [label="APPROVED"]
  mutation_gates -> kill_mutants [label="FAIL", max_visits=3]
  mutation_gates -> mutation [label="PASS"]
}
