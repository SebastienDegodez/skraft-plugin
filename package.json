{
  "name": "skraft-plugin-site-tests",
  "private": true,
  "description": "Dev-only tooling for the SKRAFT docs site smoke tests and release automation.",
  "scripts": {
    "prepare": "node scripts/install-git-hooks.mjs",
    "test:site": "playwright test",
    "test:dashboard": "node --test tests/dashboard/*.test.mjs",
    "test:engine:unit": "node --test \"tests/skraft-framework/unit/**/*.test.mjs\"",
    "test:engine:integration": "node --test \"tests/skraft-framework/integration/**/*.test.mjs\"",
    "test:engine": "npm run test:engine:unit && npm run test:engine:integration",
    "mutation:engine": "npx --prefix plugins/skraft-framework/engine stryker run plugins/skraft-framework/engine/stryker.config.mjs",
    "mutation:engine:changed": "node eng/mutation-scope.mjs --base origin/integration/v2-next --run",
    "lint:engine": "npm run lint --prefix plugins/skraft-framework/engine",
    "test:tooling": "node --test \"tests/tooling/**/*.test.mjs\"",
    "probe:copilot": "node eng/host-probe/copilot-probe.mjs",
    "test:skill-scripts": "node --test \"tests/skill-scripts/**/*.test.mjs\"",
    "catalog:scan": "node eng/catalog/scan.mjs",
    "dashboard:build": "node eng/catalog/scan.mjs && node eng/dashboard/build.mjs",
    "dashboard:serve": "node eng/dashboard/serve.mjs",
    "dashboard:preview": "./eng/dashboard/preview.sh",
    "evals": "./eng/run-vally-evals.sh",
    "lint:citations": "node scripts/check-citations.mjs --citations docs/website/data/citations.yml --pages \"docs/website/docs/**/*.md*\" --pages \"docs/website/i18n/fr/docusaurus-plugin-content-docs/current/**/*.md*\"",
    "lint:nav": "node scripts/lint-nav.mjs",
    "docs:drift": "node scripts/scan-drift.mjs --out artifacts/docs/scan-drift.json",
    "docs:translations": "node docs/website/scripts/book-translations.mjs",
    "docs:check": "node docs/website/scripts/migrate-book-schema.mjs --check && node docs/website/scripts/book-translations.mjs --check && npm run lint:nav && npm run lint:citations && npm run docs:drift",
    "docs:screenshots": "node eng/docs/screenshots.mjs",
    "docs:install": "npm ci --prefix docs/website",
    "docs:start": "npm run start --prefix docs/website --",
    "docs:start:fr": "npm run start --prefix docs/website -- --locale fr",
    "docs:build": "npm run build --prefix docs/website --",
    "docs:serve": "npm run serve --prefix docs/website --",
    "docs:check-build": "node eng/docs/check-build.mjs docs/website/build --versions docs/website/versions.json",
    "ci:local": "node scripts/local-ci.mjs",
    "plugin:build": "node scripts/project-plugin-adapters.mjs --apply && node scripts/project-plugin-adapters.mjs --apply --plugin-root plugins/skraft-backlog && node scripts/project-plugin-adapters.mjs --apply --plugin-root plugins/skraft-brownfield",
    "plugin:sync": "node scripts/project-plugin-adapters.mjs --sync && node scripts/project-plugin-adapters.mjs --sync --plugin-root plugins/skraft-backlog && node scripts/project-plugin-adapters.mjs --sync --plugin-root plugins/skraft-brownfield",
    "plugin:check": "node scripts/project-plugin-adapters.mjs --check && node scripts/project-plugin-adapters.mjs --check --plugin-root plugins/skraft-backlog && node scripts/project-plugin-adapters.mjs --check --plugin-root plugins/skraft-brownfield",
    "paths:check": "node scripts/migrate-plugin-paths.mjs --check",
    "paths:migrate": "node scripts/migrate-plugin-paths.mjs --apply",
    "hooks:install": "node scripts/install-git-hooks.mjs",
    "release": "semantic-release",
    "release:dry": "semantic-release --dry-run --no-ci",
    "skills:sync": "node scripts/sync-skill-copies.mjs --apply",
    "skills:check": "node scripts/sync-skill-copies.mjs --check",
    "test:backlog": "node --test \"tests/skraft-backlog/**/*.test.mjs\"",
    "backlog:sync": "node scripts/sync-backlog-copies.mjs --apply",
    "backlog:check": "node scripts/sync-backlog-copies.mjs --check"
  },
  "devDependencies": {
    "@github/copilot": "1.0.78",
    "@github/copilot-sdk": "1.0.9",
    "@microsoft/vally": "0.12.0",
    "@playwright/test": "^1.49.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/exec": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "conventional-changelog-conventionalcommits": "^8.0.0",
    "liquidjs": "^10.25.0",
    "semantic-release": "^24.2.0",
    "upng-js": "^2.1.0"
  },
  "overrides": {
    "@github/copilot": "1.0.78"
  }
}
