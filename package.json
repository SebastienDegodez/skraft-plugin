{
  "name": "skraft-plugin-site-tests",
  "private": true,
  "description": "Dev-only tooling for the SKRAFT docs site smoke tests and release automation.",
  "scripts": {
    "prepare": "node scripts/install-git-hooks.mjs",
    "test:site": "playwright test",
    "test:dashboard": "node --test tests/dashboard/*.test.mjs",
    "catalog:scan": "node eng/catalog/scan.mjs",
    "dashboard:build": "node eng/catalog/scan.mjs && node eng/dashboard/build.mjs",
    "dashboard:serve": "node eng/dashboard/serve.mjs",
    "dashboard:preview": "./eng/dashboard/preview.sh",
    "evals": "./eng/run-vally-evals.sh",
    "lint:citations": "node scripts/check-citations.mjs --citations docs/site/_data/citations.yml --pages \"docs/site/**/*.md\"",
    "ci:local": "node scripts/local-ci.mjs",
    "agents:sync": "node scripts/sync-agent-mirrors.mjs --apply",
    "agents:check": "node scripts/sync-agent-mirrors.mjs --check",
    "paths:check": "node scripts/migrate-plugin-paths.mjs --check",
    "paths:migrate": "node scripts/migrate-plugin-paths.mjs --apply",
    "hooks:install": "node scripts/install-git-hooks.mjs",
    "release": "semantic-release",
    "release:dry": "semantic-release --dry-run --no-ci"
  },
  "devDependencies": {
    "@github/copilot-sdk": "1.0.9",
    "@microsoft/vally": "0.12.0",
    "@playwright/test": "^1.49.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/exec": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "conventional-changelog-conventionalcommits": "^8.0.0",
    "semantic-release": "^24.2.0"
  }
}
