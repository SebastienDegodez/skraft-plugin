{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "type": "command",
        "bash": "node plugins/src/cli/hook.mjs PreToolUse Agent",
        "powershell": "node plugins/src/cli/hook.mjs PreToolUse Agent",
        "timeoutSec": 10
      },
      {
        "type": "command",
        "bash": "node plugins/src/cli/hook.mjs PreToolUse Bash",
        "powershell": "node plugins/src/cli/hook.mjs PreToolUse Bash",
        "timeoutSec": 10
      }
    ],
    "subagentStart": [
      {
        "type": "command",
        "bash": "node plugins/src/cli/hook.mjs SubagentStart",
        "powershell": "node plugins/src/cli/hook.mjs SubagentStart",
        "timeoutSec": 10
      }
    ],
    "subagentStop": [
      {
        "type": "command",
        "bash": "node plugins/src/cli/hook.mjs SubagentStop",
        "powershell": "node plugins/src/cli/hook.mjs SubagentStop",
        "timeoutSec": 10
      }
    ],
    "postToolUse": [
      {
        "type": "command",
        "bash": "node plugins/src/cli/hook.mjs PostToolUse Agent",
        "powershell": "node plugins/src/cli/hook.mjs PostToolUse Agent",
        "timeoutSec": 10
      },
      {
        "type": "command",
        "bash": "node plugins/src/cli/hook.mjs PostToolUse Read",
        "powershell": "node plugins/src/cli/hook.mjs PostToolUse Read",
        "timeoutSec": 10
      }
    ]
  }
}
