<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microcks.Testcontainers" Version="0.3.4" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.0" />
    <PackageReference Include="TUnit" Version="1.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\OrderDiscount.Api\OrderDiscount.Api.csproj" />
    <ProjectReference Include="..\..\src\OrderDiscount.Domain\OrderDiscount.Domain.csproj" />
    <ProjectReference Include="..\..\src\OrderDiscount.Infrastructure\OrderDiscount.Infrastructure.csproj" />
  </ItemGroup>

  <!-- Copy the Microcks contract artifacts (schema + examples + metadata) to output. -->
  <ItemGroup>
    <Content Include="..\..\contracts\**\*"
             Link="contracts\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
