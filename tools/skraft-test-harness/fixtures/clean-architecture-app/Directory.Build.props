<Project>

  <!-- Self-contained: overrides the harness root Directory.Build.props so the
       fixture app is an independent, buildable Clean Architecture sample. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
