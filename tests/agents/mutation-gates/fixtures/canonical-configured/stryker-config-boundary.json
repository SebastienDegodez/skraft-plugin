{
  "stryker-config": {
    "solution": "Orders.slnx",
    "mutate": [
      "**/*.API/**/*.cs",
      "**/*.Infrastructure/**/*.cs",
      "!**/*Marker.cs",
      "!**/DependencyInjection.cs",
      "!**/Program.cs",
      "!**/obj/**"
    ],
    "thresholds": {
      "high": 80,
      "low": 80,
      "break": 80
    },
    "reporters": [
      "json",
      "cleartext"
    ],
    "report-file-name": "mutation-report",
    "break-on-initial-test-failure": true
  }
}
