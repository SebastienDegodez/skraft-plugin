{
  "stryker-config": {
    "solution": "Orders.slnx",
    "mutate": [
      "**/*.Domain/**/*.cs",
      "**/*.Application/**/*.cs",
      "!**/*Marker.cs",
      "!**/DependencyInjection.cs",
      "!**/Program.cs",
      "!**/obj/**"
    ],
    "thresholds": {
      "high": 100,
      "low": 100,
      "break": 100
    },
    "reporters": [
      "json",
      "cleartext"
    ],
    "report-file-name": "mutation-report",
    "break-on-initial-test-failure": true
  }
}
