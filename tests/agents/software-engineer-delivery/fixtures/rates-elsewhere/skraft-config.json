{
  "components": [
    {
      "name": "checkout-pricing",
      "root": ".",
      "stack": "dotnet",
      "paths": {
        "src": [
          "src"
        ],
        "tests": [
          "tests"
        ]
      },
      "commands": {
        "build": "dotnet build CheckoutPricing.slnx --no-restore",
        "test": "dotnet test CheckoutPricing.slnx --no-restore",
        "architecture": "dotnet test tests/CheckoutPricing.IntegrationTest/CheckoutPricing.IntegrationTest.csproj --no-restore --filter FullyQualifiedName~Architecture"
      },
      "mocking": {
        "strategy": "microcks"
      },
      "contractTesting": false
    },
    {
      "name": "loyalty-rates",
      "root": "rates",
      "stack": "dotnet",
      "paths": {
        "src": [
          "LoyaltyRates"
        ],
        "tests": [
          "tests"
        ]
      },
      "commands": {
        "build": "dotnet build LoyaltyRates/LoyaltyRates.csproj --no-restore",
        "test": "dotnet build LoyaltyRates/LoyaltyRates.csproj --no-restore"
      },
      "mocking": {
        "strategy": "microcks"
      },
      "contractTesting": false
    }
  ]
}
