
# APM dependencies
apm_modules/
.DS_Store
plugins/.DS_Store

# Node / Playwright (dev-only site smoke tests)
node_modules/
package-lock.json
test-results/
playwright-report/
/_site/
docs/site/_site/
docs/site/.jekyll-cache/

# skraft-framework (plugins/skraft-framework/src) tooling
plugins/skraft-framework/src/node_modules/
# package-lock.json IS committed (CI mutation job uses `npm ci`, which needs it)
!plugins/skraft-framework/src/package-lock.json
.stryker-tmp/
reports/mutation/

# Docs-drift reconciler — ephemeral runtime ledger (never committed)
.skraft-docs/
.github/aw/logs/

# CCE (code-context-engine)
# CCE local cache (per-machine, not for version control)
.cce/
# Claude Code local settings written by cce init
.claude/settings.local.json
# .mcp.json contains absolute paths regenerated by `cce init`
.mcp.json
.vscode/mcp.json

# Graphify generated cache
graphify-out/
.graphify_scope_root/

# Skill evaluation & dashboard — everything here is generated, never committed.
# The catalogue is re-derived from the plugin sources on every build; verdicts
# and agent trajectories are published to the `dashboard-data` branch.
artifacts/
eval-results/
eval-results-pilot/
dashboard-data/
# eval-baselines/ IS committed: frozen results.json snapshots keyed by the repo SHA that produced them — verdicts only, never trajectories.
!eval-baselines/

# skraft-framework runtime audit log
plugins/skraft-framework/logs/

# Exclude .NET / JAVA build artifacts, IDE configs, and other local-only files.
# These are not needed for the plugin to build or run, and they clutter the repo.
# .NET build artifacts
**/bin/
**/obj/
# .NET IDE configs
**/*.user
**/*.suo
**/*.userosscache
**/*.sln.docstates
# Java build artifacts
**/target/


# skraft config/state transient files (atomic-writer artefacts — never committed)
# The canonical skraft-config.json IS versioned; its rotating backups/tmp are not.
# Match with AND without the timestamp suffix: an interrupted atomic write (killed
# process, crash) can leave a bare `*.tmp` file with no suffix, which the old
# `.tmp.*`-only patterns did not catch.
skraft-config.json.bak*
skraft-config.json.tmp*
skraft-config.json.corrupted*
**/state.json.bak*
**/state.json.tmp*
**/state.json.corrupted*
**/execution-log.json.bak*
**/execution-log.json.tmp*
**/execution-log.json.corrupted*
session-state/
